term     ::= factor ( ( '*' | '/' ) factor )*
factor   ::= exp ( '**' exp )*
exp      ::= identifier
           | number
           | '(' term ( ( '+' | '-' ) term )* ')'
identifier
         ::= [a-zA-Z_] [a-zA-Z0-9_]*
number   ::= [0-9]+